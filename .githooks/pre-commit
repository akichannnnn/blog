#!/usr/bin/env bun

import path from 'node:path';

function git(args: string[], quiet = false): { code: number; stdout: string } {
  const result = Bun.spawnSync(['git', ...args], { stdout: 'pipe', stderr: quiet ? 'pipe' : 'inherit' });
  return { code: result.exitCode, stdout: new TextDecoder().decode(result.stdout) };
}

const staged = git(['diff', '--cached', '--name-only', '--diff-filter=ACMR', '--', 'content/post']);
const posts = staged.stdout.split('\n').filter((file) =>
  /^content\/post\/(?:[^/]+\/index|[^/]+)\.md$/.test(file),
);

if (posts.length === 0) process.exit(0);

// `git add` 会重新暂存整个文件。若用户正进行部分暂存，停止提交以免悄悄带入未暂存改动。
if (git(['diff', '--quiet', '--', ...posts], true).code !== 0) {
  console.error('封面 hook 检测到暂存文章仍有未暂存改动；请先整理暂存区后再提交。');
  process.exit(1);
}

const covers = posts.map((post) => {
  const name = path.basename(post, '.md');
  const slug = name === 'index' ? path.basename(path.dirname(post)) : name;
  return `static/covers/${slug}.webp`;
});
console.log('正在补齐文章封面…');
const prepare = Bun.spawnSync(['bun', 'run', 'covers', '--', ...posts.flatMap((post) => ['--post', post])], {
  stdin: 'inherit',
  stdout: 'inherit',
  stderr: 'inherit',
});
if (prepare.exitCode !== 0) process.exit(prepare.exitCode);

const add = git(['add', '--', ...posts, ...covers]);
if (add.code !== 0) process.exit(add.code);
